# ─── Server ────────────────────────────────────────────────────────────────
# Port for the Express backend (Render sets this automatically)
PORT=3001

# Set to "production" for Render deployment
NODE_ENV=development

# ─── Frontend (client/) ───────────────────────────────────────────────────
# API URL for the React frontend in production.
# In development, Vite proxies /api requests to the backend automatically.
# In production, set this to your Render backend URL.
# VITE_API_URL=https://your-app.onrender.com
