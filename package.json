{
  "name": "latex2plain",
  "version": "0.2.2",
  "description": "Convert LaTeX math notation in Markdown files to plain Unicode text",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "latex2plain": "./dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc",
    "start": "node dist/index.js",
    "dev": "node ./node_modules/typescript/bin/tsc && node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/",
    "format": "prettier --write src/ tests/",
    "format:check": "prettier --check src/ tests/"
  },
  "keywords": [
    "latex",
    "markdown",
    "unicode",
    "math",
    "cli",
    "converter"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.5",
    "typescript-eslint": "^8.64.0",
    "vitest": "^3.2.4"
  }
}
