{
  "name": "latex2plain",
  "version": "2.1.0",
  "description": "Convert LaTeX math notation in Markdown files to plain Unicode text",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "latex2plain": "./dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc",
    "start": "node dist/index.js",
    "dev": "node ./node_modules/typescript/bin/tsc && node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/",
    "format": "prettier --write src/ tests/",
    "format:check": "prettier --check src/ tests/",
    "server": "cross-env NODE_ENV=production node dist/server.js",
    "dev:server": "node ./node_modules/typescript/bin/tsc && cross-env NODE_ENV=production node dist/server.js",
    "dev:client": "cd client && npm run dev",
    "dev:all": "node ./node_modules/typescript/bin/tsc && (cd client && npm install && npm run dev) & node dist/server.js",
    "build:client": "cd client && npm install && npm run build",
    "build:all": "npm run build && npm run build:client"
  },
  "keywords": [
    "latex",
    "markdown",
    "unicode",
    "math",
    "cli",
    "converter",
    "notation",
    "plain-text",
    "mathematics",
    "symbols"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/node": "^22.20.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "highlight.js": "^11.11.1",
    "md-to-pdf": "^5.2.5",
    "multer": "^2.2.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/pdfkit": "^0.17.6",
    "cross-env": "^10.1.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.5",
    "typescript-eslint": "^8.64.0",
    "vitest": "^3.2.4"
  }
}
