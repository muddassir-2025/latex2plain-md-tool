{
  "name": "latex2plain",
  "version": "0.1.0",
  "description": "Convert LaTeX math notation in Markdown files to plain Unicode text",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "latex2plain": "./dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc",
    "start": "node dist/index.js",
    "dev": "node ./node_modules/typescript/bin/tsc && node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "latex",
    "markdown",
    "unicode",
    "math",
    "cli",
    "converter"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
